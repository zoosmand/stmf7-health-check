    {
      "name": "Status",
      "item": [
        {
          "name": "Get device health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Device is operational\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.status).to.eql(\"ok\");",
                  "pm.expect(body.uptime).to.be.a(\"number\").and.to.be.at.least(0);",
                  "pm.expect(Number.isInteger(body.uptime)).to.eql(true);",
                  "pm.expect(body.systems).to.include({api: true, network: true, time: true, flash: true});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Head device health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Device is operational\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON representation headers are returned\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"application/json\");",
                  "  pm.expect(Number(pm.response.headers.get(\"Content-Length\"))).to.be.above(0);",
                  "});",
                  "pm.test(\"HEAD response has no body\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "HEAD",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
