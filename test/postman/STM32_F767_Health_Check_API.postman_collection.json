  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Get device health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Device is operational\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.status).to.eql(\"ok\");",
                  "pm.expect(body.systems).to.include({api: true, network: true, time: true, flash: true});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Request token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeded\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.token_type).to.eql(\"Bearer\");",
                  "if (pm.response.code === 200 && typeof body.access_token === \"string\" && body.access_token.length === 64 && typeof body.refresh_token === \"string\" && body.refresh_token.length === 64) {",
                  "  pm.environment.set(\"accessToken\", body.access_token);",
                  "  pm.environment.set(\"refreshToken\", body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const oldAccess = pm.environment.get(\"accessToken\");",
                  "const oldRefresh = pm.environment.get(\"refreshToken\");",
                  "pm.test(\"Token refresh succeeded\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "  pm.expect(body.access_token).to.not.eql(oldAccess);",
                  "  pm.expect(body.refresh_token).to.not.eql(oldRefresh);",
                  "  pm.environment.set(\"accessToken\", body.access_token);",
                  "  pm.environment.set(\"refreshToken\", body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Revoke token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Session revoked\", () => pm.response.to.have.status(200));",
                  "pm.environment.unset(\"accessToken\");",
                  "pm.environment.unset(\"refreshToken\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "revoke"
              ]
            }
          },
          "response": []
        }
      ]
    },
